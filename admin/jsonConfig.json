{
    "i18n": true,
    "type": "panel",
    "items": {
        "connectionMode": {
            "type": "select",
            "label": "Connection mode",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "default": "lan",
            "options": [
                { "label": "LAN (local MQTT at printer IP)", "value": "lan" },
                { "label": "Cloud (Bambu account MQTT)", "value": "cloud" }
            ],
            "help": "LAN: full control (fans, temps, G-code) via local MQTT + access code. Cloud: monitoring + limited control (e.g. chamber LED); H2D often blocks print.* commands over cloud — see info.cloudPrintControlBlocked."
        },
        "host": {
            "type": "text",
            "label": "Printer IP address",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "hidden": "data.connectionMode !== 'lan'"
        },
        "Password": {
            "type": "password",
            "label": "Access Token",
            "help": "API token from printer network settings - see README for detailed instructions per printer model",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "hidden": "data.connectionMode !== 'lan'"
        },
        "cloudRegion": {
            "type": "select",
            "label": "Cloud region",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "default": "global",
            "options": [
                { "label": "Global (EU/US)", "value": "global" },
                { "label": "China", "value": "china" }
            ],
            "help": "Global (EU/US) is tested. China endpoints are selectable but not verified in this fork — use at your own risk.",
            "hidden": "data.connectionMode !== 'cloud'"
        },
        "cloudLoginMethod": {
            "type": "select",
            "label": "Cloud login method",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "default": "emailCode",
            "options": [
                { "label": "E-mail code (Google/OAuth accounts)", "value": "emailCode" },
                { "label": "E-mail + Bambu password", "value": "password" }
            ],
            "help": "Google login: use e-mail code. Set a Bambu password in the app to use password login.",
            "hidden": "data.connectionMode !== 'cloud'"
        },
        "cloudEmail": {
            "type": "text",
            "label": "Bambu account (email)",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "hidden": "data.connectionMode !== 'cloud'"
        },
        "cloudVerifyCode": {
            "type": "text",
            "label": "Cloud E-Mail verification code",
            "help": "6-digit code from Bambu e-mail after first adapter start (email code method). Leave empty after successful login.",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "hidden": "data.connectionMode !== 'cloud' || data.cloudLoginMethod !== 'emailCode'"
        },
        "cloudPassword": {
            "type": "password",
            "label": "Bambu password",
            "help": "Only for password method — Bambu app password, not Google",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "hidden": "data.connectionMode !== 'cloud' || data.cloudLoginMethod !== 'password'"
        },
        "cloudAccessToken": {
            "type": "password",
            "label": "Cloud access token (optional)",
            "help": "If set, email/password are skipped. Token from Bambu login (~360 days validity). No automatic refresh — re-login when the log warns about expiry.",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "hidden": "data.connectionMode !== 'cloud'"
        },
        "cloudMqttUsername": {
            "type": "text",
            "label": "Cloud MQTT username (optional)",
            "help": "Only if cloud login works but MQTT user is missing: copy u_… from MQTTX (username field), not the password/token.",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "hidden": "data.connectionMode !== 'cloud'"
        },
        "serial": {
            "type": "text",
            "label": "Serial number of device",
            "help": "Device serial number from printer network settings - required for authentication",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "printerModel": {
            "newLine": true,
            "type": "select",
            "label": "Printer Model",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "options": [
                {
                    "label": "A1-Series",
                    "value": "A1-Series"
                },
                {
                    "label": "H2D-Series",
                    "value": "H2D-Series"
                },
                {
                    "label": "P1-Series",
                    "value": "P1-Series"
                },
                {
                    "label": "X1-Series",
                    "value": "X1-Series"
                }
            ],
            "default": "P1-Series",
            "help": "Please select your printer model"
        },
        "requestInterval": {
            "type": "number",
            "label": "Seconds between data polling",
            "help": "Only used for P1x series",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "default": 5,
            "min": 1,
            "max": 36000
        },

        "getDataFiles": {
            "newLine": true,
            "type": "fileSelector",
            "upload": "/",
            "label": "Upload g-code file",
            "help": "Here you can upload files, like g-code, to send to the printer",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "messageBuffer": {
            "type": "number",
            "label": "Message buffer",
            "help": "Only process data every X seconds, reduces CPU load. 0 = every second",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "default": 5,
            "min": 1,
            "max": 36000
        }
    }
}
